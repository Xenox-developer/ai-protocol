{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-protocol:error:3",
  "title": "Protocol v3 gateway error",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "execution"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "execution": {
          "enum": [
            "not_started",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
